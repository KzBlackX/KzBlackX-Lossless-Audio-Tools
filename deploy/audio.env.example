# /etc/kzblackx/audio.env  —  systemd EnvironmentFile (no quotes needed)
# Every flag can also be passed on the command line.

# Display name shown in the lobby.
KZBX_NAME=KzBlackX Lossless Audio Tools

# Server login password, shared by everyone. Generate one with: openssl rand -hex 16
KZBX_PASSWORD=change-me-please

# Public address clients use. REQUIRED on cloud VPS behind 1:1 NAT
# (Tencent Cloud, AWS, ...). Leave empty when the server has a public
# address on its own interface.
KZBX_PUBLIC_IP=203.0.113.10

# Single UDP port for all media. Open it in the security group / firewall.
KZBX_UDP_PORT=3478

# Rooms that always exist. More rooms are created on demand.
KZBX_ROOMS=大厅,游戏,音乐

# Limits.
KZBX_MAX_ROOM=16
KZBX_MAX_ROOMS=32
KZBX_MAX_BITRATE=510

# Temporary room files (server-side storage, auto-deleted).
KZBX_FILES_DIR=/var/lib/kzblackx/files
KZBX_MAX_FILE_MB=100
KZBX_FILE_TTL=24h

# Where HTTP listens. Ignored when ACME is enabled.
KZBX_ADDR=:8080

# --- HTTPS, option A: automatic Let's Encrypt (needs TCP 80 + 443 free) ---
# KZBX_ACME_DOMAIN=voice.example.com
# KZBX_ACME_EMAIL=you@example.com

# --- HTTPS, option B: certificate files (Baota, certbot, ...) ---
# KZBX_ADDR=:443
# KZBX_TLS_CERT=/www/server/panel/vhost/cert/voice.example.com/fullchain.pem
# KZBX_TLS_KEY=/www/server/panel/vhost/cert/voice.example.com/privkey.pem

# Set when a reverse proxy (nginx/Caddy/Baota) sits in front.
KZBX_TRUST_PROXY=0
